# Binaries. Пути с якорем: правило без ведущего слэша совпадает с любым
# вложенным каталогом такого имени, и именно так internal/seed/ однажды
# перестал попадать в репозиторий.
/bin/
/makeme

# Environment
.env

# IDE
.idea/
.vscode/
*.iml
# Скомпилированный бинарник из `go build ./cmd/seed`, а не что-либо ещё.
# Без ведущего слэша это правило съедало и internal/seed/ — пакет просто не
# попадал в репозиторий, и сборка падала на чистом клоне.
/seed

# OS
.DS_Store

# Go — только корневой vendor/ самого модуля.
# Без ведущего слэша правило съедало бы internal/web/static/vendor/ с зашитыми
# ассетами, и на чистом клоне //go:embed не собрался бы.
/vendor/

# sqlc generated (optional: uncomment if you prefer to regenerate on build)
