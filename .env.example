# HTTP server port
PORT=8080

# PostgreSQL connection string (pgx format).
# For docker-compose, use: postgres://makeme:makeme@postgres:5432/makeme?sslmode=disable
DATABASE_URL=postgres://makeme:makeme@localhost:5432/makeme?sslmode=disable

# Telegram bot token — get from @BotFather
TELEGRAM_TOKEN=your-telegram-bot-token

# Public HTTPS URL where Telegram will POST webhook updates.
# Must include the /webhook path suffix.
# For local development, use ngrok: https://xxxx.ngrok-free.app/webhook
WEBHOOK_URL=https://your-domain.com/webhook

# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=info

# Path to words JSON file for auto-seeding on startup (default: data/words.json)
# Set to empty string to skip seeding
WORDS_FILE=data/words.json

# Grammar questions seeded on startup (default: data/grammar.json)
GRAMMAR_QUESTIONS_FILE=data/grammar.json

# Grammar category explanations shown in /learn (default: data/grammar_categories.json)
GRAMMAR_CATEGORIES_FILE=data/grammar_categories.json

# Time the daily summary is sent, HH:MM 24h (default: 21:00)
SCHEDULER_TIME=21:00

# IANA timezone used by the scheduler (default: Europe/Moscow).
# Falls back to UTC if the name cannot be resolved.
TIMEZONE=Europe/Moscow

# Max task rounds each user can run per day (default: 5).
# One round = 10 tasks (5 vocab + 5 grammar).
MAX_ROUNDS_PER_DAY=5

# ── Веб-интерфейс ───────────────────────────────────────────────────────────
# Если APP_BASE_URL, TELEGRAM_CLIENT_ID, TELEGRAM_CLIENT_SECRET или JWT_SECRET
# не заданы, веб просто не монтируется — бот при этом работает как раньше.

# Публичный адрес веб-интерфейса. Из него собирается redirect_uri:
# $APP_BASE_URL/auth/telegram/callback — этот же URL нужно указать при
# регистрации OAuth-приложения у Telegram.
APP_BASE_URL=https://your-domain.com

# OAuth-креды бота (не путать с TELEGRAM_TOKEN — это другая пара).
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=

# Ключ подписи сессионного JWT. Base64, минимум 32 байта после декодирования:
#   openssl rand -base64 32
# Приложение падает на старте, если ключ короче или не base64.
JWT_SECRET=

# Время жизни сессии в часах (по умолчанию 24). Из него же берётся max-age куки.
JWT_TTL_HOURS=24

# Ставить ли флаг Secure на куки. true для прода (HTTPS обязателен),
# false только для локальной разработки по http.
COOKIE_SECURE=true

# База OIDC-провайдера и ожидаемый iss в id_token. Обе меняются вместе — и
# только осознанно: это и есть переключение на локальный брокер входа
# (telegram-login-broker), который избавляет от ngrok и походов в BotFather.
# iss сверяется побайтово, поэтому слэш в конце — уже другой issuer.
TELEGRAM_OAUTH_BASE_URL=https://oauth.telegram.org
TELEGRAM_EXPECTED_ISSUER=https://oauth.telegram.org

# Bearer token for /admin/* HTTP endpoints (e.g. POST /admin/seed-audio).
# Leave empty to disable admin endpoints (they will return 503).
# Generate a strong random value: openssl rand -hex 32
ADMIN_TOKEN=
