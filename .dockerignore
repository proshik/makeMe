# Build context for `docker build`. The Dockerfile runs `COPY . .`, so anything
# not excluded here ends up in the builder stage — .env above all, which holds
# real tokens and must never be baked into an image layer.
.git
.github
.guild
.idea
.vscode
*.iml
.DS_Store
.env

# Local binaries: make build, go build ./cmd/seed, and the tailwind CLI.
bin/
/makeme
/seed
/seed-audio
